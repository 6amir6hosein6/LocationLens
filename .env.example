# =========================================
# LocationLens Docker Environment Variables
# =========================================
# Copy this file to .env and fill in your own secure values.
# NEVER commit the actual .env file to version control.

# -------------------------------------------------------------------
# PostgreSQL (used by the 'db' service & derived DATABASE_URL)
# -------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=locationlens
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Derived database URL used by the backend app.
# In Docker the host must be the service name "db".
# For local development use localhost instead of db.
DATABASE_URL=postgresql+asyncpg://postgres:your-secure-db-password@db:5432/locationlens

# -------------------------------------------------------------------
# JWT / Authentication
# -------------------------------------------------------------------
# Secret key used to sign and verify JWT tokens.
# Generate a strong random string for production.
JWT_SECRET=your-super-secret-jwt-key-change-me

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------------------------------------------------------------------
# Admin Panel Credentials
# -------------------------------------------------------------------
# Change these defaults before deploying!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-admin-password
ADMIN_PHONE=admin_phone
ADMIN_INITIAL_COINS=999999

# -------------------------------------------------------------------
# Mock SMS Verification (for dev/testing)
# -------------------------------------------------------------------
MOCK_SMS_CODE=123456

# -------------------------------------------------------------------
# Coin Economy Settings
# -------------------------------------------------------------------
SIGNUP_BONUS_COINS=10
REVEAL_COST_COINS=1
APPROVAL_REWARD_COINS=2

# -------------------------------------------------------------------
# Coin Purchase Packages
# -------------------------------------------------------------------
COIN_PKG_STARTER_COINS=10
COIN_PKG_STARTER_PRICE=0.99
COIN_PKG_POPULAR_COINS=50
COIN_PKG_POPULAR_PRICE=3.99
COIN_PKG_PREMIUM_COINS=100
COIN_PKG_PREMIUM_PRICE=6.99

# -------------------------------------------------------------------
# Seeding (optional — set to true on first container start)
# -------------------------------------------------------------------
SEED_ON_START=false

# -------------------------------------------------------------------
# Push Notifications (Firebase Cloud Messaging)
# -------------------------------------------------------------------
# Place the Firebase service-account JSON at server/firebase-service-account.json
# (Firebase console > Project Settings > Service accounts > Generate new private key).
# It's bind-mounted into the backend container by docker-compose.yml — never commit it.
# Push notifications stay silently disabled until this file is a real key.
FIREBASE_CREDENTIALS_PATH=/app/firebase-service-account.json

# -------------------------------------------------------------------
# Web Push (browser / "Add to Home Screen" users, incl. iOS Safari PWAs)
# -------------------------------------------------------------------
# Public web-app identifiers (not secrets) from the SAME Firebase project as the Android
# app. Get them from Firebase console > Project Settings > General > Add app > Web (</>),
# and the VAPID key from Project Settings > Cloud Messaging > Web configuration >
# Generate key pair. Passed to the frontend as Docker build args (see docker-compose.yml)
# since Vite bakes them into the JS bundle at build time — a rebuild is needed after
# changing them. Leave blank to keep web push disabled; nothing else breaks.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
