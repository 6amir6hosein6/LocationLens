# Copy to .env and fill in for local dev, or set these as build-time env vars in
# whatever CI/deploy step runs `npm run build` (Vite bakes them into the JS bundle,
# they are NOT read at runtime - a rebuild is required after changing them).
#
# Web push (Firebase Cloud Messaging) for browser / "Add to Home Screen" users.
# Leave unset to leave web push disabled - nothing else breaks.
#
# Get these from Firebase console (same project as the Android app):
#   1. Project Settings > General > Your apps > Add app > Web (</>) - registers a web
#      app in the SAME Firebase project and gives you the values below.
#   2. Project Settings > Cloud Messaging > Web configuration > Generate key pair -
#      gives you VITE_FIREBASE_VAPID_KEY.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
