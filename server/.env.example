# =========================================
# LocationLens Docker Environment Variables
# =========================================
# Copy this file to .env and fill in your own secure values.
# NEVER commit the actual .env file to version control.

# -------------------------------------------------------------------
# PostgreSQL (used by the 'db' service & derived DATABASE_URL)
# -------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=locationlens
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Derived database URL used by the backend app.
# In Docker the host must be the service name "db".
# For local development use localhost instead of db.
DATABASE_URL=postgresql+asyncpg://postgres:your-secure-db-password@db:5432/locationlens

# -------------------------------------------------------------------
# JWT / Authentication
# -------------------------------------------------------------------
# Secret key used to sign and verify JWT tokens.
# Generate a strong random string for production.
JWT_SECRET=your-super-secret-jwt-key-change-me

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------------------------------------------------------------------
# Admin Panel Credentials
# -------------------------------------------------------------------
# Change these defaults before deploying!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-admin-password
ADMIN_PHONE=admin_phone
ADMIN_INITIAL_COINS=999999

# -------------------------------------------------------------------
# Mock SMS Verification (for dev/testing)
# -------------------------------------------------------------------
MOCK_SMS_CODE=123456

# -------------------------------------------------------------------
# Coin Economy Settings
# -------------------------------------------------------------------
SIGNUP_BONUS_COINS=10
REVEAL_COST_COINS=1
APPROVAL_REWARD_COINS=2

# -------------------------------------------------------------------
# Seeding (optional — set to true on first container start)
# -------------------------------------------------------------------
SEED_ON_START=false
