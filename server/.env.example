# =========================================
# LocationLens Environment Variables
# =========================================
# Copy this file to .env and fill in your own secure values.
# NEVER commit the actual .env file to version control.

# -----------------------------------------
# Database
# -----------------------------------------
# PostgreSQL connection URL (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@localhost:5432/locationlens

# -----------------------------------------
# JWT / Authentication
# -----------------------------------------
# Secret key used to sign and verify JWT tokens.
# Generate a strong random string for production.
JWT_SECRET=your-super-secret-jwt-key-change-me

# JWT signing algorithm (recommended: HS256 or RS256)
JWT_ALGORITHM=HS256

# Token expiry time in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------
# Admin Panel Credentials
# -----------------------------------------
# Username and password for logging into the admin dashboard.
# Change these defaults before deploying!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-admin-password

# Internal phone identifier used for the admin user record.
ADMIN_PHONE=admin_phone

# Starting coin balance for the admin account.
ADMIN_INITIAL_COINS=999999

# -----------------------------------------
# Mock SMS Verification
# -----------------------------------------
# For development/testing only. Any user who enters this
# code during phone verification will be authenticated.
MOCK_SMS_CODE=123456

# -----------------------------------------
# Coin Economy Settings
# -----------------------------------------
# Number of coins given to new users upon registration.
SIGNUP_BONUS_COINS=10

# Cost in coins to reveal a location's full details & map.
REVEAL_COST_COINS=1

# Number of coins rewarded to a user when their submitted
# location is approved by an admin.
APPROVAL_REWARD_COINS=2
